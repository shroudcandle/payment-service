APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
API_KEY=test-secret-api-key-999
RUN_MIGRATIONS=true
API_HOST=127.0.0.1
API_PORT=8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payments_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/payments_db

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

OUTBOX_POLL_INTERVAL=0.5
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=30.0
RELAY_RESTART_DELAY_SECONDS=5.0
MAX_DELIVERY_ATTEMPTS=3
RETRY_BASE=2.0
RETRY_CAP=30.0
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_TIMEOUT_SECONDS=5.0

HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY=10.0
HTTP_TIMEOUT_SECONDS=10.0
HTTP_CONNECT_TIMEOUT_SECONDS=5.0

RABBITMQ_HEALTH_TIMEOUT_SECONDS=1.0

GATEWAY_MIN_DELAY=2.0
GATEWAY_MAX_DELAY=5.0
GATEWAY_SUCCESS_RATE=0.9
